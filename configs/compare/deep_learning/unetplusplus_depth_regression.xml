<config>
  <include path="../../base/base.xml" />
  <include path="../../base/datasets/flooddepthnet_s1_terrain.xml" />
  <include path="../../base/unified_protocol.xml" />
  <run_name type="str">unetplusplus_depth_regression</run_name>
  <model>
    <name type="str">unetplusplus_depth_regression</name>
    <display_name type="str">U-Net++ Flood-Depth Regression</display_name>
    <input_schema type="str">s1_terrain_range</input_schema>
    <input_channels type="int">10</input_channels>
